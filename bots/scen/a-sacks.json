{
  "name": "RoyalSacks: pickup, capacity, withdraw and upgrade on server A",
  "instance": "sacks-a",
  "bots": ["alice"],
  "setup": ["op alice", "clear alice", "eco set alice 300000", "gamemode survival alice"],
  "steps": [
    { "bot": "alice", "command": "/sacks pickup on" },
    { "bot": "alice", "expectMessage": "/now go into your sacks/" },
    { "bot": "alice", "command": "/execute at alice run summon item ~ ~ ~ {Item:{id:\"minecraft:wheat\",count:64}}" },
    { "bot": "alice", "expectMessage": "/^Summoned/" },
    { "bot": "alice", "command": "/papi parse me %royalsacks_amount_wheat%" },
    { "bot": "alice", "expectMessage": "/^64$/" },
    { "bot": "alice", "command": "/sacks admin view alice" },
    { "bot": "alice", "expectMessage": "/64x wheat/" },
    { "bot": "alice", "command": "/sacks admin give alice wheat 2150" },
    { "bot": "alice", "expectMessage": "/Gave 2,150x wheat/" },
    { "bot": "alice", "command": "/execute at alice run summon item ~ ~ ~ {Item:{id:\"minecraft:wheat\",count:64}}" },
    { "bot": "alice", "expectMessage": "/is full/", "timeout": 8000 },
    { "bot": "alice", "expectItem": { "name": "wheat", "count": 38 }, "timeout": 8000 },
    { "bot": "alice", "command": "/papi parse me %royalsacks_amount_wheat%" },
    { "bot": "alice", "expectMessage": "/^2240$/" },
    { "bot": "alice", "command": "/sacks" },
    { "bot": "alice", "waitWindow": "/.*/" },
    { "bot": "alice", "click": 10 },
    { "bot": "alice", "chat": "opened agronomy" },
    { "bot": "alice", "expectMessage": "/opened agronomy/" },
    { "bot": "alice", "waitWindow": "/.*/" },
    { "bot": "alice", "click": 10 },
    { "bot": "alice", "expectMessage": "/Took 64x Wheat from your sacks/" },
    { "bot": "alice", "expectItem": { "name": "wheat", "count": 102 } },
    { "bot": "alice", "click": 49 },
    { "bot": "alice", "expectMessage": "/is now Medium and holds 20,160 of each item/" },
    { "bot": "alice", "click": 49 },
    { "bot": "alice", "expectMessage": "/You need/" },
    { "bot": "alice", "closeWindow": true },
    { "bot": "alice", "command": "/balance" },
    { "bot": "alice", "expectMessage": "/50,000/" },
    { "bot": "alice", "command": "/sacks pickup off" },
    { "bot": "alice", "expectMessage": "/stay in your inventory/" },
    { "bot": "alice", "command": "/execute at alice run summon item ~ ~ ~ {Item:{id:\"minecraft:carrot\",count:10}}" },
    { "bot": "alice", "expectItem": { "name": "carrot", "count": 10 }, "timeout": 8000 },
    { "bot": "alice", "command": "/papi parse me %royalsacks_amount_carrot%" },
    { "bot": "alice", "expectMessage": "/^0$/" },
    { "bot": "alice", "leave": true },
    { "expectLog": { "absent": "/Exception|SEVERE|ERROR\\]: \\[RoyalSacks/" } }
  ]
}
